# Business Chatbot Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# OPTIONAL SETTINGS (with defaults)
# ============================================================================

# LLM Configuration
LLM__MODEL=gpt-4
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=1000

# Anthropic API Key (optional)
LLM__ANTHROPIC_API_KEY=

# Vector Database Configuration (Milvus)
VECTOR_DB__PROVIDER=milvus
VECTOR_DB__HOST=localhost
VECTOR_DB__PORT=19530
VECTOR_DB__COLLECTION_NAME=business_data
VECTOR_DB__VECTOR_DIMENSION=512
VECTOR_DB__METRIC_TYPE=L2

# Embedding Configuration
EMBEDDING__PROVIDER=openai
EMBEDDING__MODEL=text-embedding-3-small

# Database Configuration
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USERNAME=your_db_username
DATABASE__PASSWORD=your_db_password
DATABASE__DB_NAME=ai_assistant
DATABASE__ECHO=false

# Cache Configuration
CACHE__HOST=localhost
CACHE__PORT=6379
CACHE__DB=0
CACHE__PASSWORD=

# API Configuration
API__HOST=0.0.0.0
API__PORT=8000
API__DEBUG=false