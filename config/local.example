# ============================================================================
# APPLICATION SETTINGS (secrets are required via YAML, .env or process environment)
# ============================================================================

# LLM Configuration
llm:
    model: gpt-5.4-nano
    temperature: 0.7
    max_tokens: 4000
    openai_api_key: 
    anthropic_api_key:

# Vector Database Configuration (Milvus)
vector_db:
    provider: milvus
    host: localhost
    port: 19530
    collection_name: business_data
    vector_dimension: 1024
    metric_type: Cosine

# Embedding Configuration
embedding:
    provider: openai
    model: text-embedding-3-small

# Database Configuration
database:
    host: localhost
    port: 5432
    username: congvq
    password: "" # Set here or through DATABASE__PASSWORD; no built-in DB password.
    db_name: ai_assistant
    echo: false
    sql_reader_role: sales_sql_reader # Text-to-SQL runs under this SELECT-only role (Alembic creates it); empty disables

# Cache Configuration
cache:
    provider: redis
    host: localhost
    port: 6379
    db: 0
    password:

# API Configuration
api:
    host: 127.0.0.1 # Loopback by default; use 0.0.0.0 only when remote access is intended.
    port: 8000
    debug: false
    docs_enabled: true # Swagger (/docs) and ReDoc; set false on public deployments.
    cors_origins: # Explicit origins only; "*" is rejected.
        - http://localhost:5173
        - http://127.0.0.1:5173
    public_frontend_origins: [] # Deployed frontend origins (also: env PUBLIC_FRONTEND_ORIGINS, comma separated).

# Rate limit for /auth/login, /auth/guest, /auth/refresh and /chat* (in-memory, per process)
rate_limit:
    enabled: true
    window_seconds: 60
    login_per_ip: 10
    login_per_email: 5
    guest_per_ip: 10
    refresh_per_ip: 30
    chat_per_user: 20 # /chat and /chat/stream per user
    chat_guest_per_ip: 10 # guests additionally per client IP (each guest session is a new user)
    trust_forwarded_for: false # true only behind one trusted proxy (ngrok/Cloudflare); else per-IP limits are bypassable.

# Authentication (generate a strong random secret for every environment)
auth:
    jwt_secret: # Required: provide your own random secret here or AUTH__JWT_SECRET.
    jwt_issuer: business-chatbot
    jwt_audience: business-chatbot-web
    access_token_minutes: 15
    guest_token_minutes: 60 # stateless guest access token (no refresh token, no users row)
    refresh_token_days: 30
    refresh_reuse_grace_seconds: 30 # tolerates concurrent refresh from several tabs sharing one token; 0 = strict replay detection.

# Application logs (src.* and main). Console + rotating file; relative paths are from backend/.
logging:
    enabled: true
    level: INFO # DEBUG also logs SQL rejected by the validator (may contain customer names).
    file: logs/ai_assistant.log # Empty string: console only.
    max_bytes: 10485760
    backup_count: 5

# Business ETL Configuration (Microsoft Access/iShopman)
etl:
    source_path: D:\Backup
    mdb_member: iShopman.mdb
    mdb_password: ""
    output_dir: data/etl
    snapshot_dir: data/documents
    extract_config_path: etl_business/stats/extract.yml
    product_aliases_path: etl_business/stats/product_aliases.json
    customer_ward_aliases_path: etl_business/stats/customer_ward_aliases.json
    lock_path: data/etl/business-etl.lock
    opening_balance_date: "2019-01-01"
